{
  "name": "hyperion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o src/components/storybook/static",
    "tauri": "tauri",
    "lint": "eslint src && eslint plugins",
    "format": "prettier src --write && prettier plugins --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@fltsci/tauri-plugin-tracing": "workspace:*",
    "@razein97/tauri-plugin-i18n": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-fs": "catalog:",
    "@tauri-apps/plugin-opener": "catalog:",
    "@tauri-apps/plugin-os": "catalog:",
    "lucide-react": "catalog:",
    "markdown-it": "catalog:",
    "overlayscrollbars": "catalog:",
    "overlayscrollbars-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-virtuoso": "catalog:",
    "tauri-plugin-app-events-api": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "prettier": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
